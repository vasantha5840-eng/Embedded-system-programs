#define F_CPU 16000000UL

#include <avr/io.h>
#include <util/delay.h>

int main(void)
{
    // Configure PB0, PB1 and PB2 as output
    DDRB |= (1<<PB0) | (1<<PB1) | (1<<PB2);

    while(1)
    {
        // Motor Forward
        PORTB |= (1<<PB2);
        PORTB |= (1<<PB0);
        PORTB &= ~(1<<PB1);

        _delay_ms(3000);

        // Motor Stop
        PORTB &= ~((1<<PB0) | (1<<PB1));

        _delay_ms(2000);

        // Motor Reverse
        PORTB |= (1<<PB1);
        PORTB &= ~(1<<PB0);

        _delay_ms(3000);

        // Motor Stop
        PORTB &= ~((1<<PB0) | (1<<PB1));

        _delay_ms(2000);
    }

    return 0;
}
