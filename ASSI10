
#include "main.h"
#include <stdio.h>

I2C_HandleTypeDef hi2c1;
UART_HandleTypeDef huart1;

uint8_t sensor_data[2];
char msg[100];

int main(void)
{
    HAL_Init();
    SystemClock_Config();

    MX_GPIO_Init();
    MX_I2C1_Init();
    MX_USART1_UART_Init();

    uint16_t sensor_address = 0x48 << 1;

    while (1)
    {
        if (HAL_I2C_Master_Receive(&hi2c1,
             sensor_address, sensor_data, 2, 1000) == HAL_OK)
        {
            sprintf(msg, "Sensor Data: %d\r\n",
                    (sensor_data[0] << 8) | sensor_data[1]);

            HAL_UART_Transmit(&huart1,
                (uint8_t *)msg, strlen(msg), 1000);
        }

        HAL_Delay(1000);
    }
}



